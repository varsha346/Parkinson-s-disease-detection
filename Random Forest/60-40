"""Project 14. Parkinson's Disease Detection using Random Forest"""

import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score

# ----------------------------
# Data Collection & Analysis
# ----------------------------

parkinsons_data = pd.read_csv('Parkinsson disease.csv')

# Separate features & target
X = parkinsons_data.drop(columns=['name','status'], axis=1)
Y = parkinsons_data['status']

# ----------------------------
# Train-test split
# ----------------------------
X_train, X_test, Y_train, Y_test = train_test_split(X, Y, test_size=0.4, random_state=42)

# ----------------------------
# Data Standardization
# ----------------------------
scaler = StandardScaler()
scaler.fit(X_train)

X_train = scaler.transform(X_train)
X_test = scaler.transform(X_test)

# ----------------------------
# Model Training - Random Forest
# ----------------------------
model = RandomForestClassifier(
    n_estimators=200,        # number of trees
    max_depth=None,          # let trees grow fully
    random_state=42,
    class_weight='balanced'  # handles imbalance automatically
)

model.fit(X_train, Y_train)

# ----------------------------
# Model Evaluation
# ----------------------------
train_pred = model.predict(X_train)
train_acc = accuracy_score(Y_train, train_pred)

test_pred = model.predict(X_test)
test_acc = accuracy_score(Y_test, test_pred)

algo_name = "Random Forest Classifier"
train_ratio = 0.6
test_ratio = 0.4

print("\n----------------------------------------------")
print(f"🧠 Algorithm Used: {algo_name}")
print(f"📊 Data Split: {int(train_ratio*100)}% Training | {int(test_ratio*100)}% Testing")
print("----------------------------------------------")
print(f"✅ Accuracy on Training Data: {train_acc*100:.2f}%")
print(f"✅ Accuracy on Testing Data: {test_acc*100:.2f}%")
print("----------------------------------------------")

# ----------------------------
# Building a Predictive System
# ----------------------------
input_data = (197.07600,206.89600,192.05500,0.00289,0.00001,0.00166,0.00168,0.00498,0.01098,
              0.09700,0.00563,0.00680,0.00802,0.01689,0.00339,26.77500,0.422229,0.741367,
              -7.348300,0.177551,1.743867,0.085569)

input_data_as_numpy_array = np.asarray(input_data).reshape(1, -1)
std_data = scaler.transform(input_data_as_numpy_array)
prediction = model.predict(std_data)

print(prediction)

if prediction[0] == 0:
    print("✅ The Person does NOT have Parkinson’s Disease")
else:
    print("⚠️ The Person HAS Parkinson’s Disease")
